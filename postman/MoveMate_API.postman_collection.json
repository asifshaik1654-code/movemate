          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Living Room\",\n  \"floor\": \"1st Floor\",\n  \"colorCode\": \"#4f46e5\",\n  \"notes\": \"Contains OLED TV, soundbar and book collection.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/moves/{{moveId}}/rooms", "host": ["{{baseUrl}}"], "path": ["moves", "{{moveId}}", "rooms"] }
          }
        },
        {
          "name": "List Rooms with Packing Progress",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/moves/{{moveId}}/rooms", "host": ["{{baseUrl}}"], "path": ["moves", "{{moveId}}", "rooms"] }
          }
        },
        {
          "name": "Update Room",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"floor\": \"Ground Floor\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/rooms/{{roomId}}", "host": ["{{baseUrl}}"], "path": ["rooms", "{{roomId}}"] }
          }
        }
      ]
    },
    {
      "name": "04. Boxes & QR Codes",
      "item": [
        {
          "name": "Create Box in Room",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('boxId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"description\": \"Home Theater Electronics & Cables\",\n  \"isFragile\": true,\n  \"isPriority\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/moves/{{moveId}}/boxes", "host": ["{{baseUrl}}"], "path": ["moves", "{{moveId}}", "boxes"] }
          }
        },
        {
          "name": "List Boxes with Filtering",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/moves/{{moveId}}/boxes?roomId={{roomId}}&status=Packing", "host": ["{{baseUrl}}"], "path": ["moves", "{{moveId}}", "boxes"], "query": [{ "key": "roomId", "value": "{{roomId}}" }, { "key": "status", "value": "Packing" }] }
          }
        },
        {
          "name": "Get Box by ID (Includes Base64 QR Code)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/boxes/{{boxId}}", "host": ["{{baseUrl}}"], "path": ["boxes", "{{boxId}}"] }
          }
        },
        {
          "name": "Update Box Status (Lifecycle Transition)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Packed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/boxes/{{boxId}}", "host": ["{{baseUrl}}"], "path": ["boxes", "{{boxId}}"] }
          }
        }
      ]
    },
    {
      "name": "05. Inventory Items",
      "item": [
        {
          "name": "Create Inventory Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
