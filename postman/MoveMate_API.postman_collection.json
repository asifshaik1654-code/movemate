{
  "info": {
    "_postman_id": "movemate-api-collection-v1",
    "name": "MoveMate REST API Collection",
    "description": "Complete Postman collection for MoveMate – Intelligent Home Moving Coordinator API. Covers authentication, moves, tasks, rooms, boxes, QR codes, inventory, collaboration, readiness dashboard, moving day tracker, expenses, service bookings, and activity logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00. System & Health",
      "item": [
        {
          "name": "API Welcome Message",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "http://localhost:5000/", "protocol": "http", "host": ["localhost"], "port": "5000", "path": [""] }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Register User (Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('token', json.data.token);",
                  "    pm.test('User registered & token stored', function() {",
                  "        pm.expect(json.data.token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Developer\",\n  \"email\": \"alex.dev@movemate.local\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+1 555-0199\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register Collaborator (Helper)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('collaboratorToken', json.data.token);",
                  "    pm.environment.set('collaboratorEmail', json.data.user.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Helper\",\n  \"email\": \"jordan.helper@movemate.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.dev@movemate.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02. Moving Plans",
      "item": [
        {
          "name": "Create Moving Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('moveId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Relocation to Seattle Tech Hub\",\n  \"moveDate\": \"2026-12-15T09:00:00.000Z\",\n  \"currentAddress\": \"742 Evergreen Terrace, Springfield\",\n  \"destinationAddress\": \"400 Pine Street, Seattle, WA\",\n  \"notes\": \"Fragile monitor and workstation setup requires extra cushioning.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/moves", "host": ["{{baseUrl}}"], "path": ["moves"] }
          }
        },
        {
          "name": "List User's Moves",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/moves?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["moves"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Get Move by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/moves/{{moveId}}", "host": ["{{baseUrl}}"], "path": ["moves", "{{moveId}}"] }
          }
        },
        {
          "name": "Update Move",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated packing instructions for specialized IT equipment.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/moves/{{moveId}}", "host": ["{{baseUrl}}"], "path": ["moves", "{{moveId}}"] }
          }
        }
      ]
    },
    {
      "name": "03. Rooms",
      "item": [
        {
          "name": "Create Room (Living Room)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
