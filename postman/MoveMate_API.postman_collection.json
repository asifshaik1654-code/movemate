                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sonos Beam Soundbar Gen 2\",\n  \"boxId\": \"{{boxId}}\",\n  \"quantity\": 1,\n  \"estimatedValue\": 449,\n  \"isFragile\": true,\n  \"notes\": \"Pack with original power cord and HDMI eARC cable.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/rooms/{{roomId}}/items", "host": ["{{baseUrl}}"], "path": ["rooms", "{{roomId}}", "items"] }
          }
        },
        {
          "name": "List Room Inventory (with Search)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/rooms/{{roomId}}/items?search=Soundbar", "host": ["{{baseUrl}}"], "path": ["rooms", "{{roomId}}", "items"], "query": [{ "key": "search", "value": "Soundbar" }] }
          }
        },
        {
          "name": "Update Inventory Item",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPacked\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/items/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["items", "{{itemId}}"] }
          }
        }
      ]
    },
    {
      "name": "06. Tasks & Checklist",
      "item": [
